# ==========================================
# Disaster Management Engine Environment Config
# SIH Problem Statement ID: 260001
# ==========================================

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security / CORS
FRONTEND_URL=http://localhost:5173

# Model Configuration
MODEL_PATH=models/xgboost_flood_model.joblib
RANDOM_SEED=42

# Geospatial & Hydrology Feature Flags
ENABLE_REAL_DATA=false
ENABLE_PHYSICS_SIMULATION=true

# Database Persistence (Optional - works in-memory/SQLite by default)
# For Render PostgreSQL + PostGIS: postgresql://user:password@host:5432/disaster_db
DATABASE_URL=sqlite:///./disaster_intel.db
