# ==============================================================================
# ENVIRONMENT CONFIGURATION SPECIFICATION
# SIH 2026 Problem Statement ID: 260001 - Landscape Disaster Risk Detection & Early Warning
# ==============================================================================

# Server Network Configuration
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# Database & Spatial Store (Defaults to local SQLite/Spatialite, supports PostgreSQL/PostGIS)
DATABASE_URL=sqlite:///./disaster_engine.db

# Live Meteorological & Radar Ingestion
# Note: Open-Meteo Global NWP runs automatically out-of-the-box without an API key.
WEATHER_API_KEY=
WEATHER_PROVIDER=OPEN_METEO_ECMWF

# Google Earth Engine (GEE) & Sentinel Remote Sensing Ingestion
# Optional: If GEE credentials are provided, live Earth Engine Sentinel-1/2 API is engaged.
# If omitted, system seamlessly operates with Copernicus calibrated baseline composites.
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=

# Map & Cartography Layers
# Standard CartoDB Light White GIS and OpenStreetMap basemaps require no token.
MAPBOX_TOKEN=

# Citizen Geofenced Alerting & SMS Gateway (CAP v1.2 Compliant)
# Optional: Set provider key (Twilio / Fast2SMS / MSG91) for live SMS cellular dispatch.
# If omitted, system runs in SAFE_DEMO_ALERT_MODE with explicit "Demo Alert / Provider Not Configured" label.
SMS_PROVIDER_KEY=
SMS_PROVIDER_SENDER=NDMAEW
SMS_PROVIDER_URL=
