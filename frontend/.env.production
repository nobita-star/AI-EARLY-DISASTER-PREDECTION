# Production Backend URL Configuration for Vercel
# Set this in Vercel Dashboard -> Project Settings -> Environment Variables
# Key: VITE_BACKEND_API_URL
# Value: https://<your-render-service-name>.onrender.com (without trailing slash)
#
# If left blank, the frontend dynamically prompts for the endpoint via the Top Tactical Config Bar
# or uses localStorage override.
VITE_BACKEND_API_URL=

